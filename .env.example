#--------------------------------------------------------------------
# Example Environment Configuration file
# Silayar - Digital Archive Management System
#
# Copy this file to .env and customize for your environment
# Untuk Infinityfree, uncomment dan sesuaikan settings di bawah
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Set to development, testing, or production
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Base URL untuk akses aplikasi
# LOCAL: http://localhost:8080


# Force HTTPS on production
app.forceGlobalSecureRequests = false

# Session Configuration
app.sessionDriver = 'CodeIgniter\Session\Handlers\FileHandler'
app.sessionCookieName = 'ci_session'
app.sessionSavePath = NULL
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false

# Cookie Configuration
app.cookiePrefix = ''
app.cookieDomain = ''
app.cookiePath = '/'
app.cookieSecure = false
app.cookieHTTPOnly = false

# CSRF Protection
app.CSRFProtection  = true
app.CSRFTokenName   = 'csrf_test_name'
app.CSRFCookieName  = 'csrf_cookie_name'
app.CSRFExpire      = 7200
app.CSRFRegenerate  = true
app.CSRFExcludeURIs = []

# Content Security Policy
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# LOCAL DEVELOPMENT (XAMPP/Laragon)
# database.default.hostname = localhost
# database.default.database = aplikasi_arsip
# database.default.username = root
# database.default.password = 
# database.default.DBDriver = MySQLi



# Database Port (optional, default 3306)
database.default.port = 3306

#--------------------------------------------------------------------
# CONTENT SECURITY POLICY
#--------------------------------------------------------------------

contentsecuritypolicy.reportOnly = false
contentsecuritypolicy.defaultSrc = 'none'
contentsecuritypolicy.scriptSrc = 'self'
contentsecuritypolicy.styleSrc = 'self'
contentsecuritypolicy.imageSrc = 'self'
contentsecuritypolicy.base_uri = null
contentsecuritypolicy.childSrc = null
contentsecuritypolicy.connectSrc = 'self'
contentsecuritypolicy.fontSrc = null
contentsecuritypolicy.formAction = null
contentsecuritypolicy.frameAncestors = null
contentsecuritypolicy.mediaSrc = null
contentsecuritypolicy.objectSrc = null
contentsecuritypolicy.pluginTypes = null
contentsecuritypolicy.reportURI = null
contentsecuritypolicy.sandbox = false
contentsecuritypolicy.upgradeInsecureRequests = false

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# IMPORTANT: Generate a random string untuk production
# Gunakan: https://www.random.org/strings/ atau `php -r "echo bin2hex(random_bytes(32))"`
# encryption.key = 

encryption.driver = OpenSSL

#--------------------------------------------------------------------
# HONEYPOT
#--------------------------------------------------------------------

honeypot.hidden = 'true'
honeypot.label = 'Fill This Field'
honeypot.name = 'honeypot'
honeypot.template = '<label>{label}</label><input type="text" name="{name}" value=""/>'
honeypot.container = '<div style="display:none">{template}</div>'

#--------------------------------------------------------------------
# LOGGING
#--------------------------------------------------------------------

# Log Threshold
# 0 - Emergency
# 1 - Alert
# 2 - Critical
# 3 - Error
# 4 - Warning
# 5 - Notice
# 6 - Info
# 7 - Debug
log.threshold = 4

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

# Valid handlers: dummy, file, memcached, redis, wincache
cache.handler = file
cache.backup = file

#--------------------------------------------------------------------
# PRODUCTION SETTINGS (Uncomment saat deploy ke production)
#--------------------------------------------------------------------

# Production Mode
# CI_ENVIRONMENT = production

# Disable Debug Mode
# php_display_errors = 0

# Strong CSRF Protection
# app.CSRFProtection = true

# Secure Cookies
# app.cookieSecure = true
# app.cookieHTTPOnly = true

# Force HTTPS
# app.forceGlobalSecureRequests = true